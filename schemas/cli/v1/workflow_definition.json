{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/cli/v1/workflow_definition.json",
  "$defs": {
    "artifact_requirement_base": {
      "type": "object",
      "properties": {
        "type": { "enum": ["document", "candidate", "test", "review", "publication"] },
        "cardinality": { "enum": ["one", "many"] },
        "subject": { "enum": ["task", "candidate"] },
        "allowed_states": { "type": "array", "items": { "enum": ["produced", "passed", "failed", "approved", "changes_requested", "published"] }, "minItems": 1, "uniqueItems": true }
      },
      "required": ["type", "cardinality", "subject", "allowed_states"],
      "additionalProperties": false
    },
    "artifact_requirement": {
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/artifact_requirement_base" }, { "properties": { "type": { "const": "document" }, "subject": { "const": "task" }, "allowed_states": { "items": { "const": "produced" } } } }] },
        { "allOf": [{ "$ref": "#/$defs/artifact_requirement_base" }, { "properties": { "type": { "const": "candidate" }, "subject": { "const": "task" }, "allowed_states": { "items": { "const": "produced" } } } }] },
        { "allOf": [{ "$ref": "#/$defs/artifact_requirement_base" }, { "properties": { "type": { "const": "test" }, "subject": { "const": "candidate" }, "allowed_states": { "items": { "enum": ["passed", "failed"] } } } }] },
        { "allOf": [{ "$ref": "#/$defs/artifact_requirement_base" }, { "properties": { "type": { "const": "review" }, "subject": { "const": "candidate" }, "allowed_states": { "items": { "enum": ["approved", "changes_requested"] } } } }] },
        { "allOf": [{ "$ref": "#/$defs/artifact_requirement_base" }, { "properties": { "type": { "const": "publication" }, "subject": { "const": "candidate" }, "allowed_states": { "items": { "const": "published" } } } }] }
      ]
    },
    "artifact_template": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.json#/$defs/identifier" },
        "media_type": { "const": "text/markdown; charset=utf-8" },
        "content": { "type": "string", "minLength": 1, "x-max-utf8-bytes": 1048576 }
      },
      "required": ["id", "media_type", "content"],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.json#/$defs/identifier" },
        "execution_mode": { "enum": ["main_session", "subagent"] },
        "instruction": { "type": "string", "minLength": 1, "x-media-type": "text/markdown; charset=utf-8", "x-max-utf8-bytes": 131072 },
        "artifact_templates": { "type": "array", "items": { "$ref": "#/$defs/artifact_template" }, "x-unique-by": "id" },
        "allowed_repository_effects": { "type": "array", "items": { "enum": ["worktree_remove", "commit", "fetch", "rebase", "push"] }, "uniqueItems": true },
        "worktree": { "enum": ["required", "none"] },
        "repository_changes": { "enum": ["allowed", "forbidden"] },
        "required_artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact_requirement" }, "x-unique-by": "type" }
      },
      "required": ["id", "execution_mode", "instruction", "artifact_templates", "allowed_repository_effects", "worktree", "repository_changes", "required_artifacts"],
      "x-max-total-content-bytes": 4194304,
      "additionalProperties": false
    },
    "always_condition": { "type": "object", "properties": { "type": { "const": "always" } }, "required": ["type"], "additionalProperties": false },
    "artifact_present_condition": { "type": "object", "properties": { "type": { "const": "artifact-present" }, "artifact_type": { "enum": ["document", "candidate", "test", "review", "publication"] } }, "required": ["type", "artifact_type"], "additionalProperties": false },
    "artifact_state_condition": { "type": "object", "properties": { "type": { "const": "artifact-state" }, "artifact_type": { "enum": ["document", "candidate", "test", "review", "publication"] }, "state": { "enum": ["produced", "passed", "failed", "approved", "changes_requested", "published"] } }, "required": ["type", "artifact_type", "state"], "additionalProperties": false },
    "decision_condition": { "type": "object", "properties": { "type": { "const": "decision" }, "decision": { "$ref": "common.json#/$defs/identifier" }, "value": { "$ref": "common.json#/$defs/identifier" } }, "required": ["type", "decision", "value"], "additionalProperties": false },
    "not_applicable_condition": { "type": "object", "properties": { "type": { "const": "not-applicable" }, "artifact_type": { "enum": ["document", "candidate", "test", "review", "publication"] } }, "required": ["type", "artifact_type"], "additionalProperties": false },
    "condition": { "oneOf": [{ "$ref": "#/$defs/always_condition" }, { "$ref": "#/$defs/artifact_present_condition" }, { "$ref": "#/$defs/artifact_state_condition" }, { "$ref": "#/$defs/decision_condition" }, { "$ref": "#/$defs/not_applicable_condition" }] },
    "transition": {
      "type": "object",
      "properties": {
        "from": { "$ref": "common.json#/$defs/identifier" },
        "to": { "$ref": "common.json#/$defs/identifier" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "minItems": 1, "uniqueItems": true }
      },
      "required": ["from", "to", "conditions"],
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "common.json#/$defs/schema_version" },
        "workflow_id": { "$ref": "common.json#/$defs/identifier" },
        "task_type": { "const": "quick-fix" },
        "version": { "$ref": "common.json#/$defs/semantic_version" },
        "initial_status": { "$ref": "common.json#/$defs/identifier" },
        "terminal_status": { "$ref": "common.json#/$defs/identifier" },
        "statuses": { "type": "array", "items": { "$ref": "#/$defs/status" }, "minItems": 1, "x-unique-by": "id" },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" }, "minItems": 1 }
      },
      "required": ["schema_version", "workflow_id", "task_type", "version", "initial_status", "terminal_status", "statuses", "transitions"],
      "x-graph-validation": ["unique-statuses", "initial-executable", "terminal-distinct", "terminal-has-no-outgoing-transition", "known-endpoints", "unique-edges", "all-states-reachable", "executable-states-have-outgoing-transition", "always-is-sole-condition", "one-artifact-condition-per-type-per-edge", "one-value-per-decision-per-edge", "unambiguous-decisions", "artifact-evidence-complete-per-edge", "artifact-states-covered-across-routes", "repository-effects-compatible-with-policy", "repository-changes-require-worktree"],
      "x-content-digest": "sha256-rfc8785-canonical-definition",
      "additionalProperties": false
    }
  }
}
