{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/cli/v1/workflow.json",
  "$defs": {
    "worktree_context": {
      "type": "object",
      "properties": { "reservation_id": { "$ref": "common.json#/$defs/uuid" }, "path": { "type": "string", "minLength": 1 }, "branch": { "type": "string", "minLength": 1 }, "head_sha": { "$ref": "common.json#/$defs/git_oid" } },
      "required": ["reservation_id", "path", "branch", "head_sha"], "additionalProperties": false
    },
    "worktree_create_effect": { "type": "object", "properties": { "operation": { "const": "worktree_create" }, "reservation_id": { "$ref": "common.json#/$defs/uuid" }, "expected_head_sha": { "$ref": "common.json#/$defs/git_oid" } }, "required": ["operation", "reservation_id", "expected_head_sha"], "additionalProperties": false },
    "worktree_remove_effect": { "type": "object", "properties": { "operation": { "const": "worktree_remove" }, "reservation_id": { "$ref": "common.json#/$defs/uuid" }, "expected_head_sha": { "$ref": "common.json#/$defs/git_oid" } }, "required": ["operation", "reservation_id", "expected_head_sha"], "additionalProperties": false },
    "commit_effect": { "type": "object", "properties": { "operation": { "const": "commit" }, "reservation_id": { "$ref": "common.json#/$defs/uuid" }, "expected_head_sha": { "$ref": "common.json#/$defs/git_oid" }, "expected_diff_digest": { "$ref": "common.json#/$defs/digest" }, "expected_index_digest": { "$ref": "common.json#/$defs/digest" }, "paths": { "type": "array", "items": { "$ref": "common.json#/$defs/repository_path" }, "minItems": 1, "uniqueItems": true }, "message": { "type": "string", "minLength": 1 }, "task_number": { "$ref": "common.json#/$defs/task_number" } }, "required": ["operation", "reservation_id", "expected_head_sha", "expected_diff_digest", "expected_index_digest", "paths", "message", "task_number"], "additionalProperties": false },
    "fetch_effect": { "type": "object", "properties": { "operation": { "const": "fetch" }, "remote": { "$ref": "common.json#/$defs/identifier" }, "ref": { "type": "string", "pattern": "^refs/[^ ]+$" } }, "required": ["operation", "remote", "ref"], "additionalProperties": false },
    "rebase_effect": { "type": "object", "properties": { "operation": { "const": "rebase" }, "reservation_id": { "$ref": "common.json#/$defs/uuid" }, "expected_head_sha": { "$ref": "common.json#/$defs/git_oid" }, "onto_sha": { "$ref": "common.json#/$defs/git_oid" } }, "required": ["operation", "reservation_id", "expected_head_sha", "onto_sha"], "additionalProperties": false },
    "push_effect": { "type": "object", "properties": { "operation": { "const": "push" }, "publication_id": { "$ref": "common.json#/$defs/uuid" }, "candidate_sha": { "$ref": "common.json#/$defs/git_oid" }, "remote": { "$ref": "common.json#/$defs/identifier" }, "base_ref": { "type": "string", "pattern": "^refs/heads/[^ ]+$" }, "expected_remote_oid": { "$ref": "common.json#/$defs/git_oid" } }, "required": ["operation", "publication_id", "candidate_sha", "remote", "base_ref", "expected_remote_oid"], "additionalProperties": false },
    "requested_effect": { "oneOf": [{ "$ref": "#/$defs/worktree_create_effect" }, { "$ref": "#/$defs/worktree_remove_effect" }, { "$ref": "#/$defs/commit_effect" }, { "$ref": "#/$defs/fetch_effect" }, { "$ref": "#/$defs/rebase_effect" }, { "$ref": "#/$defs/push_effect" }] },
    "context": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "common.json#/$defs/schema_version" }, "task_id": { "$ref": "common.json#/$defs/uuid" },
        "attempt_id": { "$ref": "common.json#/$defs/uuid" }, "repository_id": { "$ref": "common.json#/$defs/uuid" },
        "workflow_status": { "$ref": "common.json#/$defs/identifier" }, "bundle_digest": { "$ref": "common.json#/$defs/digest" },
        "instruction_digest": { "$ref": "common.json#/$defs/digest" }, "expected_lock_version": { "type": "integer", "minimum": 0 },
        "fencing_token": { "type": "integer", "minimum": 1 }, "base_ref": { "type": "string", "pattern": "^refs/heads/[^ ]+$" },
        "candidate_sha": { "$ref": "common.json#/$defs/git_oid" }, "worktree": { "$ref": "#/$defs/worktree_context" },
        "required_artifact_types": { "type": "array", "items": { "enum": ["document", "candidate", "test", "review", "publication"] }, "uniqueItems": true },
        "allowed_capabilities": { "type": "array", "items": { "$ref": "common.json#/$defs/identifier" }, "uniqueItems": true }
      },
      "required": ["schema_version", "task_id", "attempt_id", "repository_id", "workflow_status", "bundle_digest", "instruction_digest", "expected_lock_version", "fencing_token", "base_ref", "required_artifact_types", "allowed_capabilities"],
      "additionalProperties": false
    },
    "result_manifest": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "common.json#/$defs/schema_version" }, "attempt_id": { "$ref": "common.json#/$defs/uuid" },
        "input_context_digest": { "$ref": "common.json#/$defs/digest" }, "outcome": { "enum": ["succeeded", "failed", "needs_human"] },
        "artifacts": { "type": "array", "items": { "$ref": "artifacts.json#/$defs/artifact_input" } },
        "requested_effects": { "type": "array", "items": { "$ref": "#/$defs/requested_effect" }, "uniqueItems": true },
        "summary": { "type": "string", "minLength": 1 }
      },
      "required": ["schema_version", "attempt_id", "input_context_digest", "outcome", "artifacts"],
      "additionalProperties": false
    }
  }
}
