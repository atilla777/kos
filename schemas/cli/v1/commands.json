{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/cli/v1/commands.json",
  "$defs": {
    "command_identifier": { "enum": ["repository.register", "runtime_config.get", "runtime_config.update", "task_type.list", "workflow.list", "workflow.get", "workflow.export", "workflow_draft.get", "workflow_draft.import", "workflow_draft.validate", "workflow.publish", "workflow.activate", "task.get", "attempt.get", "step.context", "worktree.get", "effect.get", "artifact.list", "publication.get", "task.create", "attempt.claim", "attempt.renew", "attempt.fail", "attempt.needs_human", "attempt.reconcile", "worktree.reserve", "worktree.confirm", "worktree.reconcile", "worktree.release", "effect.prepare", "effect.reconcile", "artifact.register", "step.complete", "publication.prepare", "publication.reconcile", "publication.complete"] },
    "empty_body": { "type": "object", "additionalProperties": false },
    "pagination": { "type": "object", "properties": { "cursor": { "type": "string", "minLength": 1, "maxLength": 255 }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } }, "required": ["limit"], "additionalProperties": false },
    "repository_register_body": { "type": "object", "properties": { "git_common_dir": { "$ref": "common.json#/$defs/absolute_path" }, "task_prefix": { "$ref": "common.json#/$defs/task_prefix" }, "trusted_remote": { "$ref": "common.json#/$defs/identifier" }, "trusted_remote_url": { "$ref": "common.json#/$defs/remote_url" }, "base_ref": { "$ref": "common.json#/$defs/base_ref" } }, "required": ["git_common_dir", "task_prefix", "trusted_remote", "trusted_remote_url", "base_ref"], "additionalProperties": false },
    "repository_registration_request": { "type": "object", "properties": { "schema_version": { "$ref": "common.json#/$defs/schema_version" }, "command": { "const": "repository.register" }, "body": { "$ref": "#/$defs/repository_register_body" } }, "required": ["schema_version", "command", "body"], "additionalProperties": false },
    "global_request_base": { "type": "object", "properties": { "schema_version": { "$ref": "common.json#/$defs/schema_version" }, "command": { "$ref": "#/$defs/command_identifier" }, "body": { "type": "object" } }, "required": ["schema_version", "command", "body"] },
    "scoped_request_base": { "type": "object", "properties": { "schema_version": { "$ref": "common.json#/$defs/schema_version" }, "command": { "$ref": "#/$defs/command_identifier" }, "repository_id": { "$ref": "common.json#/$defs/uuid" }, "body": { "type": "object" } }, "required": ["schema_version", "command", "repository_id", "body"] },
    "workflow_version_locator": { "type": "object", "properties": { "workflow_version_id": { "$ref": "common.json#/$defs/uuid" } }, "required": ["workflow_version_id"], "additionalProperties": false },
    "workflow_draft_locator": { "type": "object", "properties": { "workflow_id": { "$ref": "common.json#/$defs/identifier" } }, "required": ["workflow_id"], "additionalProperties": false },
    "global_read_request": {
      "allOf": [{ "$ref": "#/$defs/global_request_base" }, { "oneOf": [
        { "properties": { "command": { "const": "runtime_config.get" }, "body": { "$ref": "#/$defs/empty_body" } } },
        { "properties": { "command": { "enum": ["task_type.list", "workflow.list"] }, "body": { "$ref": "#/$defs/pagination" } } },
        { "properties": { "command": { "enum": ["workflow.get", "workflow.export"] }, "body": { "$ref": "#/$defs/workflow_version_locator" } } },
        { "properties": { "command": { "enum": ["workflow_draft.get", "workflow_draft.validate"] }, "body": { "$ref": "#/$defs/workflow_draft_locator" } } }
      ] }],
      "unevaluatedProperties": false
    },
    "runtime_config_update_body": { "type": "object", "properties": { "retrospective_enabled": { "type": "boolean" }, "expected_lock_version": { "type": "integer", "minimum": 0 } }, "required": ["retrospective_enabled", "expected_lock_version"], "additionalProperties": false },
    "workflow_draft_import_body": { "type": "object", "properties": { "workflow_id": { "$ref": "common.json#/$defs/identifier" }, "definition": { "$ref": "workflow_definition.json#/$defs/definition" }, "expected_lock_version": { "type": "integer", "minimum": 0 } }, "required": ["workflow_id", "definition", "expected_lock_version"], "x-field-equality": [["workflow_id", "definition.workflow_id"]], "additionalProperties": false },
    "workflow_publish_body": { "type": "object", "properties": { "workflow_id": { "$ref": "common.json#/$defs/identifier" }, "expected_lock_version": { "type": "integer", "minimum": 0 } }, "required": ["workflow_id", "expected_lock_version"], "additionalProperties": false },
    "workflow_activate_body": { "type": "object", "properties": { "task_type": { "const": "quick-fix" }, "workflow_version_id": { "$ref": "common.json#/$defs/uuid" }, "expected_lock_version": { "type": "integer", "minimum": 0 } }, "required": ["task_type", "workflow_version_id", "expected_lock_version"], "additionalProperties": false },
    "global_mutation_request": {
      "allOf": [{ "$ref": "#/$defs/global_request_base" }, { "oneOf": [
        { "properties": { "command": { "const": "runtime_config.update" }, "body": { "$ref": "#/$defs/runtime_config_update_body" } } },
        { "properties": { "command": { "const": "workflow_draft.import" }, "body": { "$ref": "#/$defs/workflow_draft_import_body" } } },
        { "properties": { "command": { "const": "workflow.publish" }, "body": { "$ref": "#/$defs/workflow_publish_body" } } },
        { "properties": { "command": { "const": "workflow.activate" }, "body": { "$ref": "#/$defs/workflow_activate_body" } } }
      ] }],
      "unevaluatedProperties": false
    },
    "task_locator": { "type": "object", "properties": { "task_number": { "$ref": "common.json#/$defs/task_number" } }, "required": ["task_number"], "additionalProperties": false },
    "attempt_locator": { "type": "object", "properties": { "attempt_id": { "$ref": "common.json#/$defs/uuid" } }, "required": ["attempt_id"], "additionalProperties": false },
    "reservation_locator": { "type": "object", "properties": { "reservation_id": { "$ref": "common.json#/$defs/uuid" } }, "required": ["reservation_id"], "additionalProperties": false },
    "publication_locator": { "type": "object", "properties": { "publication_id": { "$ref": "common.json#/$defs/uuid" } }, "required": ["publication_id"], "additionalProperties": false },
    "effect_locator": { "type": "object", "properties": { "effect_id": { "$ref": "common.json#/$defs/uuid" } }, "required": ["effect_id"], "additionalProperties": false },
    "artifact_list_body": { "type": "object", "properties": { "task_number": { "$ref": "common.json#/$defs/task_number" }, "cursor": { "type": "string", "minLength": 1, "maxLength": 255 }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } }, "required": ["task_number", "limit"], "additionalProperties": false },
    "scoped_read_request": { "allOf": [{ "$ref": "#/$defs/scoped_request_base" }, { "oneOf": [
      { "properties": { "command": { "const": "task.get" }, "body": { "$ref": "#/$defs/task_locator" } } },
      { "properties": { "command": { "const": "attempt.get" }, "body": { "$ref": "#/$defs/attempt_locator" } } },
      { "properties": { "command": { "const": "worktree.get" }, "body": { "$ref": "#/$defs/reservation_locator" } } },
      { "properties": { "command": { "const": "effect.get" }, "body": { "$ref": "#/$defs/effect_locator" } } },
      { "properties": { "command": { "const": "artifact.list" }, "body": { "$ref": "#/$defs/artifact_list_body" } } },
      { "properties": { "command": { "const": "publication.get" }, "body": { "$ref": "#/$defs/publication_locator" } } }
    ] }], "unevaluatedProperties": false },
    "attempt_renew_body": { "type": "object", "properties": { "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" }, "lease_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 } }, "required": ["preconditions", "lease_seconds"], "additionalProperties": false },
    "failed_manifest": { "allOf": [{ "$ref": "workflow.json#/$defs/result_manifest" }, { "properties": { "outcome": { "const": "failed" } } }] },
    "needs_human_manifest": { "allOf": [{ "$ref": "workflow.json#/$defs/result_manifest" }, { "properties": { "outcome": { "const": "needs_human" } } }] },
    "successful_manifest": { "allOf": [{ "$ref": "workflow.json#/$defs/result_manifest" }, { "properties": { "outcome": { "const": "succeeded" } } }] },
    "attempt_fail_body": { "type": "object", "properties": { "result_manifest": { "$ref": "#/$defs/failed_manifest" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["result_manifest", "preconditions"], "additionalProperties": false },
    "attempt_needs_human_body": { "type": "object", "properties": { "result_manifest": { "$ref": "#/$defs/needs_human_manifest" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["result_manifest", "preconditions"], "additionalProperties": false },
    "reconcile_attempt_body": { "type": "object", "properties": { "attempt_id": { "$ref": "common.json#/$defs/uuid" }, "observed_state": { "enum": ["no_effect", "worktree_materialized", "repository_effect_pending", "publication_unknown"] }, "evidence_digest": { "$ref": "common.json#/$defs/digest" }, "expected_lock_version": { "type": "integer", "minimum": 0 } }, "required": ["attempt_id", "observed_state", "evidence_digest", "expected_lock_version"], "additionalProperties": false },
    "step_context_body": { "type": "object", "properties": { "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["preconditions"], "additionalProperties": false },
    "worktree_reserve_body": { "type": "object", "properties": { "task_number": { "$ref": "common.json#/$defs/task_number" }, "branch": { "$ref": "common.json#/$defs/task_branch" }, "path": { "type": "string", "minLength": 1 }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["task_number", "branch", "path", "preconditions"], "x-derived-field": { "field": "branch", "template": "kos/task-{task_number}" }, "additionalProperties": false },
    "worktree_confirm_body": { "type": "object", "properties": { "reservation_id": { "$ref": "common.json#/$defs/uuid" }, "git_common_dir_digest": { "$ref": "common.json#/$defs/digest" }, "head_sha": { "$ref": "common.json#/$defs/git_oid" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["reservation_id", "git_common_dir_digest", "head_sha", "preconditions"], "additionalProperties": false },
    "worktree_observation_body": { "type": "object", "properties": { "reservation_id": { "$ref": "common.json#/$defs/uuid" }, "observed_state": { "enum": ["absent", "clean", "dirty", "mismatched"] }, "head_sha": { "$ref": "common.json#/$defs/git_oid" }, "evidence_digest": { "$ref": "common.json#/$defs/digest" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["reservation_id", "observed_state", "evidence_digest", "preconditions"], "additionalProperties": false },
    "effect_prepare_body": { "type": "object", "properties": { "task_number": { "$ref": "common.json#/$defs/task_number" }, "effect_request": { "$ref": "workflow.json#/$defs/durable_effect_request" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["task_number", "effect_request", "preconditions"], "x-field-equality": [["effect_request.attempt_id", "preconditions.attempt_id"]], "x-context-bindings": [["effect_request.input_context_digest", "stored_attempt.input_context_digest"], ["effect_request.effect.task_number", "task_number", "when-present"], ["effect_request.effect.operation", "stored_context.allowed_repository_effects", "member-of"], ["effect_request.effect.reservation_id", "stored_context.worktree.reservation_id", "when-present"], ["effect_request.effect.expected_head_sha", "stored_context.worktree.head_sha", "when-present"]], "additionalProperties": false },
    "effect_reconcile_body": { "type": "object", "properties": { "effect_id": { "$ref": "common.json#/$defs/uuid" }, "effect_result": { "$ref": "workflow.json#/$defs/durable_effect_result" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["effect_id", "effect_result", "preconditions"], "x-field-equality": [["effect_id", "effect_result.effect_intent_id"], ["effect_result.owner_attempt_id", "preconditions.attempt_id"]], "x-stored-effect-bindings": [["effect_result.request_attempt_id", "request.attempt_id"], ["effect_result.input_context_digest", "request.input_context_digest"], ["effect_result.effect_request_digest", "request_digest"], ["effect_result.result.operation", "request.effect.operation"]], "additionalProperties": false },
    "artifact_register_body": { "type": "object", "properties": { "task_number": { "$ref": "common.json#/$defs/task_number" }, "artifact": { "$ref": "artifacts.json#/$defs/artifact_input" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["task_number", "artifact", "preconditions"], "additionalProperties": false },
    "step_complete_body": { "type": "object", "properties": { "task_number": { "$ref": "common.json#/$defs/task_number" }, "to_status": { "$ref": "common.json#/$defs/identifier" }, "result_manifest": { "$ref": "#/$defs/successful_manifest" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["task_number", "to_status", "result_manifest", "preconditions"], "additionalProperties": false },
    "publication_prepare_body": { "type": "object", "properties": { "task_number": { "$ref": "common.json#/$defs/task_number" }, "candidate_sha": { "$ref": "common.json#/$defs/git_oid" }, "remote": { "$ref": "common.json#/$defs/identifier" }, "base_ref": { "$ref": "common.json#/$defs/base_ref" }, "expected_remote_oid": { "$ref": "common.json#/$defs/git_oid" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["task_number", "candidate_sha", "remote", "base_ref", "expected_remote_oid", "preconditions"], "additionalProperties": false },
    "publication_reconcile_body": { "type": "object", "properties": { "publication_id": { "$ref": "common.json#/$defs/uuid" }, "candidate_sha": { "$ref": "common.json#/$defs/git_oid" }, "observed_remote_tip": { "$ref": "common.json#/$defs/git_oid" }, "candidate_reachable": { "type": "boolean" }, "observed_at": { "$ref": "common.json#/$defs/timestamp" }, "evidence_digest": { "$ref": "common.json#/$defs/digest" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["publication_id", "candidate_sha", "observed_remote_tip", "candidate_reachable", "observed_at", "evidence_digest", "preconditions"], "additionalProperties": false },
    "publication_complete_manifest": { "allOf": [{ "$ref": "#/$defs/successful_manifest" }, { "properties": { "artifacts": { "contains": { "properties": { "type": { "const": "publication" }, "state": { "const": "published" }, "metadata": { "$ref": "artifacts.json#/$defs/publication_metadata" } }, "required": ["type", "state", "metadata"] }, "minContains": 1 } } }] },
    "publication_complete_body": { "type": "object", "properties": { "publication_id": { "$ref": "common.json#/$defs/uuid" }, "task_number": { "$ref": "common.json#/$defs/task_number" }, "to_status": { "const": "completed" }, "result_manifest": { "$ref": "#/$defs/publication_complete_manifest" }, "preconditions": { "$ref": "common.json#/$defs/leased_preconditions" } }, "required": ["publication_id", "task_number", "to_status", "result_manifest", "preconditions"], "additionalProperties": false },
    "scoped_mutation_request": { "allOf": [{ "$ref": "#/$defs/scoped_request_base" }, { "oneOf": [
      { "properties": { "command": { "const": "task.create" }, "body": { "type": "object", "properties": { "title": { "type": "string", "minLength": 1 }, "task_type": { "const": "quick-fix" } }, "required": ["title", "task_type"], "additionalProperties": false } } },
      { "properties": { "command": { "const": "attempt.claim" }, "body": { "type": "object", "properties": { "task_number": { "$ref": "common.json#/$defs/task_number" }, "owner_id": { "$ref": "common.json#/$defs/identifier" }, "lease_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 }, "preconditions": { "$ref": "common.json#/$defs/preconditions" } }, "required": ["task_number", "owner_id", "lease_seconds", "preconditions"], "additionalProperties": false } } },
      { "properties": { "command": { "const": "attempt.renew" }, "body": { "$ref": "#/$defs/attempt_renew_body" } } },
      { "properties": { "command": { "const": "attempt.fail" }, "body": { "$ref": "#/$defs/attempt_fail_body" } } },
      { "properties": { "command": { "const": "attempt.needs_human" }, "body": { "$ref": "#/$defs/attempt_needs_human_body" } } },
      { "properties": { "command": { "const": "attempt.reconcile" }, "body": { "$ref": "#/$defs/reconcile_attempt_body" } } },
      { "properties": { "command": { "const": "step.context" }, "body": { "$ref": "#/$defs/step_context_body" } } },
      { "properties": { "command": { "const": "worktree.reserve" }, "body": { "$ref": "#/$defs/worktree_reserve_body" } } },
      { "properties": { "command": { "const": "worktree.confirm" }, "body": { "$ref": "#/$defs/worktree_confirm_body" } } },
      { "properties": { "command": { "enum": ["worktree.reconcile", "worktree.release"] }, "body": { "$ref": "#/$defs/worktree_observation_body" } } },
      { "properties": { "command": { "const": "effect.prepare" }, "body": { "$ref": "#/$defs/effect_prepare_body" } } },
      { "properties": { "command": { "const": "effect.reconcile" }, "body": { "$ref": "#/$defs/effect_reconcile_body" } } },
      { "properties": { "command": { "const": "artifact.register" }, "body": { "$ref": "#/$defs/artifact_register_body" } } },
      { "properties": { "command": { "const": "step.complete" }, "body": { "$ref": "#/$defs/step_complete_body" } } },
      { "properties": { "command": { "const": "publication.prepare" }, "body": { "$ref": "#/$defs/publication_prepare_body" } } },
      { "properties": { "command": { "const": "publication.reconcile" }, "body": { "$ref": "#/$defs/publication_reconcile_body" } } },
      { "properties": { "command": { "const": "publication.complete" }, "body": { "$ref": "#/$defs/publication_complete_body" } } }
    ] }], "unevaluatedProperties": false },
    "request": { "oneOf": [{ "$ref": "#/$defs/repository_registration_request" }, { "$ref": "#/$defs/global_read_request" }, { "$ref": "#/$defs/global_mutation_request" }, { "$ref": "#/$defs/scoped_read_request" }, { "$ref": "#/$defs/scoped_mutation_request" }] },
    "task_types_data": { "type": "object", "properties": { "task_types": { "type": "array", "items": { "$ref": "resources.json#/$defs/task_type" } }, "next_cursor": { "type": "string", "minLength": 1, "maxLength": 255 } }, "required": ["task_types"], "additionalProperties": false },
    "workflows_data": { "type": "object", "properties": { "workflows": { "type": "array", "items": { "$ref": "resources.json#/$defs/workflow_version_summary" } }, "next_cursor": { "type": "string", "minLength": 1, "maxLength": 255 } }, "required": ["workflows"], "additionalProperties": false },
    "validation_data": { "type": "object", "properties": { "valid": { "type": "boolean" }, "errors": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } }, "required": ["field", "message"], "additionalProperties": false } } }, "required": ["valid", "errors"], "additionalProperties": false },
    "artifacts_data": { "type": "object", "properties": { "artifacts": { "type": "array", "items": { "$ref": "artifacts.json#/$defs/artifact" } }, "next_cursor": { "type": "string", "minLength": 1, "maxLength": 255 } }, "required": ["artifacts"], "additionalProperties": false },
    "step_complete_data": { "type": "object", "properties": { "task": { "$ref": "resources.json#/$defs/task" }, "artifacts": { "type": "array", "items": { "$ref": "artifacts.json#/$defs/artifact" } } }, "required": ["task", "artifacts"], "additionalProperties": false },
    "publication_complete_data": { "type": "object", "properties": { "task": { "$ref": "resources.json#/$defs/task" }, "artifacts": { "type": "array", "items": { "$ref": "artifacts.json#/$defs/artifact" }, "contains": { "properties": { "type": { "const": "publication" }, "state": { "const": "published" } }, "required": ["type", "state"] }, "minContains": 1 } }, "required": ["task", "artifacts"], "additionalProperties": false },
    "result": {
      "allOf": [{ "$ref": "envelopes.json#/$defs/success" }, { "oneOf": [
        { "properties": { "command": { "const": "repository.register" }, "data": { "$ref": "resources.json#/$defs/repository" } } },
        { "properties": { "command": { "enum": ["runtime_config.get", "runtime_config.update"] }, "data": { "$ref": "resources.json#/$defs/runtime_config" } } },
        { "properties": { "command": { "const": "task_type.list" }, "data": { "$ref": "#/$defs/task_types_data" } } },
        { "properties": { "command": { "const": "workflow.list" }, "data": { "$ref": "#/$defs/workflows_data" } } },
        { "properties": { "command": { "enum": ["workflow.get", "workflow.publish"] }, "data": { "$ref": "resources.json#/$defs/workflow_version" } } },
        { "properties": { "command": { "const": "workflow.export" }, "data": { "$ref": "workflow_definition.json#/$defs/definition" } } },
        { "properties": { "command": { "enum": ["workflow_draft.get", "workflow_draft.import"] }, "data": { "$ref": "resources.json#/$defs/workflow_draft" } } },
        { "properties": { "command": { "const": "workflow_draft.validate" }, "data": { "$ref": "#/$defs/validation_data" } } },
        { "properties": { "command": { "const": "workflow.activate" }, "data": { "$ref": "resources.json#/$defs/task_type" } } },
        { "properties": { "command": { "enum": ["task.get", "task.create"] }, "data": { "$ref": "resources.json#/$defs/task" } } },
        { "properties": { "command": { "enum": ["attempt.get", "attempt.claim", "attempt.renew", "attempt.reconcile"] }, "data": { "$ref": "resources.json#/$defs/attempt" } } },
        { "properties": { "command": { "const": "attempt.fail" }, "data": { "allOf": [{ "$ref": "resources.json#/$defs/attempt" }, { "properties": { "state": { "const": "failed" } } }] } } },
        { "properties": { "command": { "const": "attempt.needs_human" }, "data": { "allOf": [{ "$ref": "resources.json#/$defs/attempt" }, { "properties": { "state": { "const": "needs_human" } } }] } } },
        { "properties": { "command": { "const": "step.context" }, "data": { "$ref": "workflow.json#/$defs/context" } } },
        { "properties": { "command": { "enum": ["worktree.get", "worktree.reserve", "worktree.confirm", "worktree.reconcile", "worktree.release"] }, "data": { "$ref": "resources.json#/$defs/worktree_reservation" } } },
        { "properties": { "command": { "enum": ["effect.get", "effect.prepare", "effect.reconcile"] }, "data": { "$ref": "resources.json#/$defs/repository_effect" } } },
        { "properties": { "command": { "const": "artifact.list" }, "data": { "$ref": "#/$defs/artifacts_data" } } },
        { "properties": { "command": { "const": "artifact.register" }, "data": { "$ref": "artifacts.json#/$defs/artifact" } } },
        { "properties": { "command": { "const": "publication.get" }, "data": { "$ref": "resources.json#/$defs/publication" } } },
        { "properties": { "command": { "const": "step.complete" }, "data": { "$ref": "#/$defs/step_complete_data" } } },
        { "properties": { "command": { "const": "publication.prepare" }, "data": { "allOf": [{ "$ref": "resources.json#/$defs/publication" }, { "properties": { "state": { "const": "prepared" } } }] } } },
        { "properties": { "command": { "const": "publication.reconcile" }, "data": { "allOf": [{ "$ref": "resources.json#/$defs/publication" }, { "properties": { "state": { "const": "reconciled" } } }] } } },
        { "properties": { "command": { "const": "publication.complete" }, "data": { "$ref": "#/$defs/publication_complete_data" } } }
      ] }],
      "unevaluatedProperties": false
    }
  }
}
