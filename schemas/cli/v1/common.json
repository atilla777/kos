{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/cli/v1/common.json",
  "$defs": {
    "schema_version": { "const": "1" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,127}$" },
    "semantic_version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "uuid": { "type": "string", "format": "uuid" },
    "task_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}(?![\\s\\S])" },
    "task_number": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}-[0-9]{6}(?![\\s\\S])" },
    "task_branch": { "type": "string", "pattern": "^kos/task-[A-Z][A-Z0-9]{1,9}-[0-9]{6}(?![\\s\\S])" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "git_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "repository_path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "absolute_path": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$" },
    "remote_url": { "type": "string", "format": "uri", "maxLength": 4096, "pattern": "^(?:https?|ssh|git|file)://(?![^/?#]*:[^/?#]*@)[^?#]+$" },
    "base_ref": { "type": "string", "pattern": "^refs/heads/[^ ]+$" },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 255, "pattern": "^[A-Za-z0-9._:-]+$" },
    "preconditions": {
      "type": "object",
      "properties": {
        "expected_lock_version": { "type": "integer", "minimum": 0 },
        "attempt_id": { "$ref": "#/$defs/uuid" },
        "fencing_token": { "type": "integer", "minimum": 1 }
      },
      "required": ["expected_lock_version"],
      "additionalProperties": false
    },
    "leased_preconditions": {
      "allOf": [
        { "$ref": "#/$defs/preconditions" },
        { "required": ["attempt_id", "fencing_token"] }
      ],
      "unevaluatedProperties": false
    }
  }
}
