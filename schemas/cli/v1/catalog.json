{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/cli/v1/catalog.json",
  "x-success-cli-exit": 0,
  "$defs": {
    "command_entry": {
      "type": "object",
      "properties": {
        "identifier": { "$ref": "commands.json#/$defs/command_identifier" },
        "scope": { "enum": ["global", "repository_registration", "repository"] },
        "cli_suffix": { "type": "string", "minLength": 1 },
        "http_method": { "enum": ["GET", "POST"] },
        "http_path": { "type": "string", "pattern": "^/api/v1/" },
        "success_status": { "enum": [200, 201] },
        "mutation": { "type": "boolean" },
        "required_preconditions": { "type": "array", "items": { "enum": ["idempotency", "lock", "attempt", "fencing"] }, "uniqueItems": true }
      },
      "required": ["identifier", "scope", "cli_suffix", "http_method", "http_path", "success_status", "mutation", "required_preconditions"],
      "allOf": [
        { "if": { "properties": { "scope": { "const": "repository_registration" } }, "required": ["scope"] }, "then": { "properties": { "identifier": { "const": "repository.register" }, "http_path": { "const": "/api/v1/repositories" } } } },
        { "if": { "properties": { "scope": { "const": "repository" } }, "required": ["scope"] }, "then": { "properties": { "http_path": { "pattern": "^/api/v1/repositories/\\{repository_id\\}/" } } } },
        { "if": { "properties": { "scope": { "const": "global" } }, "required": ["scope"] }, "then": { "properties": { "http_path": { "not": { "pattern": "^/api/v1/repositories" } } } } }
      ],
      "additionalProperties": false
    },
    "error_entry": { "type": "object", "properties": { "code": { "$ref": "envelopes.json#/$defs/error_code" }, "category": { "$ref": "envelopes.json#/$defs/error_category" }, "http_status": { "type": "integer", "minimum": 400, "maximum": 599 }, "cli_exit": { "type": "integer", "minimum": 1, "maximum": 8 }, "retryable": { "type": "boolean" } }, "required": ["code", "category", "http_status", "cli_exit", "retryable"], "additionalProperties": false }
  },
