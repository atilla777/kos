{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/cli/v1/catalog.json",
  "x-success-cli-exit": 0,
  "$defs": {
    "command_entry": {
      "type": "object",
      "properties": {
        "identifier": { "$ref": "commands.json#/$defs/command_identifier" },
        "cli_suffix": { "type": "string", "minLength": 1 },
        "http_method": { "enum": ["GET", "POST"] },
        "http_path": { "type": "string", "pattern": "^/api/v1/repositories(?:$|/\\{repository_id\\}/)" },
        "success_status": { "enum": [200, 201] },
        "mutation": { "type": "boolean" },
        "required_preconditions": { "type": "array", "items": { "enum": ["idempotency", "lock", "attempt", "fencing"] }, "uniqueItems": true }
      },
      "required": ["identifier", "cli_suffix", "http_method", "http_path", "success_status", "mutation", "required_preconditions"],
      "allOf": [
        {
          "if": { "properties": { "identifier": { "const": "repository.register" } }, "required": ["identifier"] },
          "then": { "properties": { "http_path": { "const": "/api/v1/repositories" } } },
          "else": { "properties": { "http_path": { "pattern": "^/api/v1/repositories/\\{repository_id\\}/" } } }
        }
      ],
      "additionalProperties": false
    },
    "error_entry": {
      "type": "object",
      "properties": {
        "code": { "$ref": "envelopes.json#/$defs/error_code" },
        "category": { "$ref": "envelopes.json#/$defs/error_category" },
        "http_status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "cli_exit": { "type": "integer", "minimum": 1, "maximum": 8 },
        "retryable": { "type": "boolean" }
      },
      "required": ["code", "category", "http_status", "cli_exit", "retryable"],
      "additionalProperties": false
    }
  },
  "x-command-catalog": [
    { "identifier": "repository.register", "cli_suffix": "repository register", "http_method": "POST", "http_path": "/api/v1/repositories", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency"] },
    { "identifier": "task_type.list", "cli_suffix": "task-type list", "http_method": "GET", "http_path": "/api/v1/repositories/{repository_id}/task-types", "success_status": 200, "mutation": false, "required_preconditions": [] },
    { "identifier": "workflow.list", "cli_suffix": "workflow list", "http_method": "GET", "http_path": "/api/v1/repositories/{repository_id}/workflows", "success_status": 200, "mutation": false, "required_preconditions": [] },
    { "identifier": "workflow.get", "cli_suffix": "workflow get", "http_method": "GET", "http_path": "/api/v1/repositories/{repository_id}/workflows/{workflow_id}/versions/{version}", "success_status": 200, "mutation": false, "required_preconditions": [] },
    { "identifier": "task.get", "cli_suffix": "task get", "http_method": "GET", "http_path": "/api/v1/repositories/{repository_id}/tasks/{task_number}", "success_status": 200, "mutation": false, "required_preconditions": [] },
    { "identifier": "attempt.get", "cli_suffix": "attempt get", "http_method": "GET", "http_path": "/api/v1/repositories/{repository_id}/attempts/{attempt_id}", "success_status": 200, "mutation": false, "required_preconditions": [] },
    { "identifier": "worktree.get", "cli_suffix": "worktree get", "http_method": "GET", "http_path": "/api/v1/repositories/{repository_id}/worktree-reservations/{reservation_id}", "success_status": 200, "mutation": false, "required_preconditions": [] },
    { "identifier": "artifact.list", "cli_suffix": "artifact list", "http_method": "GET", "http_path": "/api/v1/repositories/{repository_id}/tasks/{task_number}/artifacts", "success_status": 200, "mutation": false, "required_preconditions": [] },
    { "identifier": "publication.get", "cli_suffix": "publication get", "http_method": "GET", "http_path": "/api/v1/repositories/{repository_id}/publications/{publication_id}", "success_status": 200, "mutation": false, "required_preconditions": [] },
    { "identifier": "task.create", "cli_suffix": "task create", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/tasks", "success_status": 201, "mutation": true, "required_preconditions": ["idempotency"] },
    { "identifier": "attempt.claim", "cli_suffix": "attempt claim", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/tasks/{task_number}/attempts/claim", "success_status": 201, "mutation": true, "required_preconditions": ["idempotency", "lock"] },
    { "identifier": "attempt.renew", "cli_suffix": "attempt renew", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/attempts/{attempt_id}/renew", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "attempt.fail", "cli_suffix": "attempt fail", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/attempts/{attempt_id}/fail", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "attempt.needs_human", "cli_suffix": "attempt needs-human", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/attempts/{attempt_id}/needs-human", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "attempt.reconcile", "cli_suffix": "attempt reconcile", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/attempts/{attempt_id}/reconcile", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt"] },
    { "identifier": "step.context", "cli_suffix": "step context", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/attempts/{attempt_id}/step-context", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "worktree.reserve", "cli_suffix": "worktree reserve", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/tasks/{task_number}/worktree-reservations", "success_status": 201, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "worktree.confirm", "cli_suffix": "worktree confirm", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/worktree-reservations/{reservation_id}/confirm", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "worktree.reconcile", "cli_suffix": "worktree reconcile", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/worktree-reservations/{reservation_id}/reconcile", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "worktree.release", "cli_suffix": "worktree release", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/worktree-reservations/{reservation_id}/release", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "artifact.register", "cli_suffix": "artifact register", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/tasks/{task_number}/artifacts", "success_status": 201, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "step.complete", "cli_suffix": "step complete", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/tasks/{task_number}/steps/complete", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "publication.prepare", "cli_suffix": "publication prepare", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/tasks/{task_number}/publications", "success_status": 201, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "publication.reconcile", "cli_suffix": "publication reconcile", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/publications/{publication_id}/reconcile", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "publication.complete", "cli_suffix": "publication complete", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/publications/{publication_id}/complete", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] }
  ],
  "x-error-catalog": [
    { "code": "malformed_input", "category": "validation", "http_status": 400, "cli_exit": 2, "retryable": false },
    { "code": "unsupported_schema_version", "category": "validation", "http_status": 400, "cli_exit": 2, "retryable": false },
    { "code": "unknown_command", "category": "validation", "http_status": 400, "cli_exit": 2, "retryable": false },
    { "code": "invalid_artifact", "category": "validation", "http_status": 422, "cli_exit": 2, "retryable": false },
    { "code": "repository_registration_invalid", "category": "validation", "http_status": 422, "cli_exit": 2, "retryable": false },
    { "code": "authentication_required", "category": "authentication", "http_status": 401, "cli_exit": 3, "retryable": false },
    { "code": "invalid_token", "category": "authentication", "http_status": 401, "cli_exit": 3, "retryable": false },
    { "code": "forbidden", "category": "authorization", "http_status": 403, "cli_exit": 4, "retryable": false },
    { "code": "repository_access_denied", "category": "authorization", "http_status": 403, "cli_exit": 4, "retryable": false },
    { "code": "task_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "workflow_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "attempt_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "reservation_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "artifact_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "publication_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "stale_lock_version", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "invalid_transition", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "idempotency_conflict", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "idempotency_in_progress", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "dependency_unsatisfied", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "base_moved", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "context_unavailable", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "bundle_inconsistent", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "repository_registration_conflict", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "lease_expired", "category": "lease_lost", "http_status": 409, "cli_exit": 7, "retryable": false },
    { "code": "fencing_token_stale", "category": "lease_lost", "http_status": 409, "cli_exit": 7, "retryable": false },
    { "code": "transport_unavailable", "category": "transient", "http_status": 503, "cli_exit": 8, "retryable": true },
    { "code": "request_timeout", "category": "transient", "http_status": 504, "cli_exit": 8, "retryable": true },
    { "code": "internal_error", "category": "internal", "http_status": 500, "cli_exit": 1, "retryable": false }
  ]
}
