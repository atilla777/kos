    { "identifier": "attempt.renew", "scope": "repository", "cli_suffix": "attempt renew", "http_method": "POST", "http_path": "/api/v1/repositories/{repository_id}/attempts/{attempt_id}/renew", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
