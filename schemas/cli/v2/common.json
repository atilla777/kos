{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/cli/v2/common.json",
  "$defs": {
    "schema_version": { "const": "2" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,127}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "task_number": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}-[0-9]{6}(?![\\s\\S])" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "git_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "base_ref": { "type": "string", "pattern": "^refs/heads/[^ ]+$" },
    "leased_preconditions": {
      "type": "object",
      "properties": {
        "expected_lock_version": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "attempt_id": { "$ref": "#/$defs/uuid" },
        "fencing_token": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "required": ["expected_lock_version", "attempt_id", "fencing_token"],
      "additionalProperties": false
    }
  }
}
