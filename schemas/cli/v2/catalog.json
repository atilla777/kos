{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/cli/v2/catalog.json",
  "x-success-cli-exit": 0,
  "$defs": {
    "command_entry": {
      "type": "object",
      "properties": {
        "identifier": { "$ref": "commands.json#/$defs/command_identifier" },
        "scope": { "const": "repository" },
        "cli_suffix": { "enum": ["publication-preflight get", "publication-preflight prepare", "publication-preflight reconcile", "publication prepare-observed", "publication recover-base-moved", "publication-result get", "publication-result record", "effect reconcile-rebase"] },
        "http_method": { "enum": ["GET", "POST"] },
        "http_path": { "type": "string", "pattern": "^/api/v2/repositories/\\{repository_id\\}/" },
        "success_status": { "enum": [200, 201] },
        "mutation": { "type": "boolean" },
        "required_preconditions": { "type": "array", "items": { "enum": ["idempotency", "lock", "attempt", "fencing"] }, "uniqueItems": true }
      },
      "required": ["identifier", "scope", "cli_suffix", "http_method", "http_path", "success_status", "mutation", "required_preconditions"],
      "additionalProperties": false
    },
    "error_entry": { "type": "object", "properties": { "code": { "$ref": "envelopes.json#/$defs/error_code" }, "category": { "$ref": "envelopes.json#/$defs/error_category" }, "http_status": { "type": "integer", "minimum": 400, "maximum": 599 }, "cli_exit": { "type": "integer", "minimum": 1, "maximum": 8 }, "retryable": { "type": "boolean" } }, "required": ["code", "category", "http_status", "cli_exit", "retryable"], "additionalProperties": false }
  },
  "x-command-catalog": [
    { "identifier": "publication_preflight.get", "scope": "repository", "cli_suffix": "publication-preflight get", "http_method": "GET", "http_path": "/api/v2/repositories/{repository_id}/publication-preflights/{preflight_id}", "success_status": 200, "mutation": false, "required_preconditions": [] },
    { "identifier": "publication_preflight.prepare", "scope": "repository", "cli_suffix": "publication-preflight prepare", "http_method": "POST", "http_path": "/api/v2/repositories/{repository_id}/tasks/{task_number}/publication-preflights", "success_status": 201, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "publication_preflight.reconcile", "scope": "repository", "cli_suffix": "publication-preflight reconcile", "http_method": "POST", "http_path": "/api/v2/repositories/{repository_id}/publication-preflights/{preflight_id}/reconcile", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "publication.prepare_observed", "scope": "repository", "cli_suffix": "publication prepare-observed", "http_method": "POST", "http_path": "/api/v2/repositories/{repository_id}/publication-preflights/{preflight_id}/publication", "success_status": 201, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "publication.recover_base_moved", "scope": "repository", "cli_suffix": "publication recover-base-moved", "http_method": "POST", "http_path": "/api/v2/repositories/{repository_id}/publications/{publication_id}/recover-base-moved", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "publication_result.get", "scope": "repository", "cli_suffix": "publication-result get", "http_method": "GET", "http_path": "/api/v2/repositories/{repository_id}/publications/{publication_id}/result", "success_status": 200, "mutation": false, "required_preconditions": [] },
    { "identifier": "publication_result.record", "scope": "repository", "cli_suffix": "publication-result record", "http_method": "POST", "http_path": "/api/v2/repositories/{repository_id}/publications/{publication_id}/result", "success_status": 201, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] },
    { "identifier": "effect.reconcile_rebase", "scope": "repository", "cli_suffix": "effect reconcile-rebase", "http_method": "POST", "http_path": "/api/v2/repositories/{repository_id}/repository-effects/{effect_id}/reconcile-rebase", "success_status": 200, "mutation": true, "required_preconditions": ["idempotency", "lock", "attempt", "fencing"] }
  ],
  "x-error-catalog": [
    { "code": "malformed_input", "category": "validation", "http_status": 400, "cli_exit": 2, "retryable": false },
    { "code": "unsupported_schema_version", "category": "validation", "http_status": 400, "cli_exit": 2, "retryable": false },
    { "code": "unknown_command", "category": "validation", "http_status": 400, "cli_exit": 2, "retryable": false },
    { "code": "invalid_artifact", "category": "validation", "http_status": 422, "cli_exit": 2, "retryable": false },
    { "code": "authentication_required", "category": "authentication", "http_status": 401, "cli_exit": 3, "retryable": false },
    { "code": "invalid_token", "category": "authentication", "http_status": 401, "cli_exit": 3, "retryable": false },
    { "code": "forbidden", "category": "authorization", "http_status": 403, "cli_exit": 4, "retryable": false },
    { "code": "repository_access_denied", "category": "authorization", "http_status": 403, "cli_exit": 4, "retryable": false },
    { "code": "task_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "attempt_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "publication_preflight_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "publication_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "publication_result_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "effect_not_found", "category": "not_found", "http_status": 404, "cli_exit": 5, "retryable": false },
    { "code": "context_unavailable", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "stale_lock_version", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "invalid_transition", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "idempotency_conflict", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "idempotency_in_progress", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "dependency_unsatisfied", "category": "conflict", "http_status": 409, "cli_exit": 6, "retryable": false },
    { "code": "lease_expired", "category": "lease_lost", "http_status": 409, "cli_exit": 7, "retryable": false },
    { "code": "fencing_token_stale", "category": "lease_lost", "http_status": 409, "cli_exit": 7, "retryable": false },
    { "code": "transport_unavailable", "category": "transient", "http_status": 503, "cli_exit": 8, "retryable": true },
    { "code": "request_timeout", "category": "transient", "http_status": 504, "cli_exit": 8, "retryable": true },
    { "code": "internal_error", "category": "internal", "http_status": 500, "cli_exit": 1, "retryable": false }
  ]
}
