{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/repository/v1/adapter.json",
  "$defs": {
    "schema_version": { "const": "1" },
    "uuid": { "type": "string", "format": "uuid" },
    "git_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,127}$" },
    "remote_url": { "type": "string", "format": "uri", "maxLength": 4096, "pattern": "^(?:(?:https|ssh|git)://(?![^/?#]*:[^/?#]*@)[^?#]+|file://[^/?#]*/[^?#]*)$" },
    "absolute_path": { "type": "string", "minLength": 1, "pattern": "^/", "x-canonical-path": true },
    "branch": { "type": "string", "pattern": "^kos/task-[A-Z][A-Z0-9]{1,9}-[0-9]{6}$" },
    "task_number": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}-[0-9]{6}$" },
    "repository_path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!:)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\u0000).+$", "x-canonical-path": true, "x-exact-file": true },
    "repository": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "git_common_dir": { "$ref": "#/$defs/absolute_path" },
        "base_ref": { "type": "string", "pattern": "^refs/heads/[^ ]+$" }
      },
      "required": ["id", "git_common_dir", "base_ref"],
      "additionalProperties": false
    },
    "reservation": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "repository_id": { "$ref": "#/$defs/uuid" },
        "state": { "enum": ["reserved", "confirmed", "release_pending"] },
        "path": { "$ref": "#/$defs/absolute_path" },
        "branch": { "$ref": "#/$defs/branch" },
        "fencing_token": { "type": "integer", "minimum": 1 }
      },
      "required": ["id", "repository_id", "state", "path", "branch", "fencing_token"],
      "additionalProperties": false
    },
    "request_base": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "operation": { "enum": ["materialize", "observe", "remove"] },
        "repository": { "$ref": "#/$defs/repository" },
        "reservation": { "$ref": "#/$defs/reservation" },
        "expected_head_sha": { "$ref": "#/$defs/git_oid" }
      },
      "required": ["schema_version", "operation", "repository", "reservation", "expected_head_sha"],
      "additionalProperties": false
    },
    "materialize_request": {
      "allOf": [
        { "$ref": "#/$defs/request_base" },
        { "properties": { "operation": { "const": "materialize" }, "reservation": { "properties": { "state": { "const": "reserved" } } } } }
      ]
    },
    "observe_request": {
      "allOf": [
        { "$ref": "#/$defs/request_base" },
        { "properties": { "operation": { "const": "observe" } } }
      ]
    },
    "remove_request": {
      "allOf": [
        { "$ref": "#/$defs/request_base" },
        { "properties": { "operation": { "const": "remove" }, "reservation": { "properties": { "state": { "const": "release_pending" } } } } }
      ]
    },
    "commit_request": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "operation": { "const": "commit" },
        "repository": { "$ref": "#/$defs/repository" },
        "reservation": { "allOf": [{ "$ref": "#/$defs/reservation" }, { "properties": { "state": { "const": "confirmed" } } }] },
        "expected_head_sha": { "$ref": "#/$defs/git_oid" },
        "expected_diff_digest": { "$ref": "#/$defs/digest" },
        "expected_index_digest": { "$ref": "#/$defs/digest" },
        "paths": { "type": "array", "items": { "$ref": "#/$defs/repository_path" }, "minItems": 1, "uniqueItems": true },
        "message": { "type": "string", "minLength": 1 },
        "task_number": { "$ref": "#/$defs/task_number" }
      },
      "required": ["schema_version", "operation", "repository", "reservation", "expected_head_sha", "expected_diff_digest", "expected_index_digest", "paths", "message", "task_number"],
      "x-task-number-derives-reservation-branch": true,
      "additionalProperties": false
    },
    "fetch_repository": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "git_common_dir": { "$ref": "#/$defs/absolute_path" },
        "trusted_remote": { "$ref": "#/$defs/identifier" },
        "trusted_remote_url": { "$ref": "#/$defs/remote_url" },
        "base_ref": { "type": "string", "pattern": "^refs/heads/[^ ]+$" }
      },
      "required": ["id", "git_common_dir", "trusted_remote", "trusted_remote_url", "base_ref"],
      "additionalProperties": false
    },
    "durable_fetch_effect": {
      "type": "object",
      "properties": {
        "operation": { "const": "fetch" },
        "remote": { "$ref": "#/$defs/identifier" },
        "ref": { "type": "string", "pattern": "^refs/[^ ]+$" }
      },
      "required": ["operation", "remote", "ref"],
      "additionalProperties": false
    },
    "durable_fetch_request": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "attempt_id": { "$ref": "#/$defs/uuid" },
        "input_context_digest": { "$ref": "#/$defs/digest" },
        "effect": { "$ref": "#/$defs/durable_fetch_effect" }
      },
      "required": ["schema_version", "attempt_id", "input_context_digest", "effect"],
      "additionalProperties": false
    },
    "fetch_effect_snapshot": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "repository_id": { "$ref": "#/$defs/uuid" },
        "current_owner_attempt_id": { "$ref": "#/$defs/uuid" },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "request_digest": { "$ref": "#/$defs/digest" },
        "request": { "$ref": "#/$defs/durable_fetch_request" }
      },
      "required": ["id", "repository_id", "current_owner_attempt_id", "fencing_token", "request_digest", "request"],
      "additionalProperties": false
    },
    "fetch_request": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "operation": { "const": "fetch" },
        "repository": { "$ref": "#/$defs/fetch_repository" },
        "effect": { "$ref": "#/$defs/fetch_effect_snapshot" }
      },
      "required": ["schema_version", "operation", "repository", "effect"],
      "additionalProperties": false
    },
    "request": { "oneOf": [{ "$ref": "#/$defs/materialize_request" }, { "$ref": "#/$defs/observe_request" }, { "$ref": "#/$defs/remove_request" }, { "$ref": "#/$defs/commit_request" }, { "$ref": "#/$defs/fetch_request" }] },
    "observation": {
      "type": "object",
      "properties": {
        "state": { "enum": ["absent", "clean", "dirty", "mismatched"] },
        "head_sha": { "$ref": "#/$defs/git_oid" },
        "git_common_dir_digest": { "$ref": "#/$defs/digest" },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["state", "evidence_digest"],
      "allOf": [
        { "if": { "properties": { "state": { "enum": ["clean", "dirty"] } }, "required": ["state"] }, "then": { "required": ["head_sha", "git_common_dir_digest"] } },
        { "if": { "properties": { "state": { "const": "absent" } }, "required": ["state"] }, "then": { "not": { "anyOf": [{ "required": ["head_sha"] }, { "required": ["git_common_dir_digest"] }] } } }
      ],
      "additionalProperties": false
    },
    "worktree_success": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "operation": { "enum": ["materialize", "observe", "remove"] },
        "outcome": { "const": "succeeded" },
        "repository_id": { "$ref": "#/$defs/uuid" },
        "reservation_id": { "$ref": "#/$defs/uuid" },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "observation": { "$ref": "#/$defs/observation" }
      },
      "required": ["schema_version", "operation", "outcome", "repository_id", "reservation_id", "fencing_token", "observation"],
      "additionalProperties": false
    },
    "commit_success": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "operation": { "const": "commit" },
        "outcome": { "const": "succeeded" },
        "repository_id": { "$ref": "#/$defs/uuid" },
        "reservation_id": { "$ref": "#/$defs/uuid" },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "commit_sha": { "$ref": "#/$defs/git_oid" },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["schema_version", "operation", "outcome", "repository_id", "reservation_id", "fencing_token", "commit_sha", "evidence_digest"],
      "additionalProperties": false
    },
    "fetch_success": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "operation": { "const": "fetch" },
        "outcome": { "const": "succeeded" },
        "repository_id": { "$ref": "#/$defs/uuid" },
        "effect_id": { "$ref": "#/$defs/uuid" },
        "current_owner_attempt_id": { "$ref": "#/$defs/uuid" },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "effect_request_digest": { "$ref": "#/$defs/digest" },
        "remote": { "$ref": "#/$defs/identifier" },
        "ref": { "type": "string", "pattern": "^refs/heads/[^ ]+$" },
        "observed_oid": { "$ref": "#/$defs/git_oid" },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["schema_version", "operation", "outcome", "repository_id", "effect_id", "current_owner_attempt_id", "fencing_token", "effect_request_digest", "remote", "ref", "observed_oid", "evidence_digest"],
      "additionalProperties": false
    },
    "success": { "oneOf": [{ "$ref": "#/$defs/worktree_success" }, { "$ref": "#/$defs/commit_success" }, { "$ref": "#/$defs/fetch_success" }] },
    "error": {
      "type": "object",
      "properties": {
        "category": { "enum": ["validation", "conflict", "transient", "internal"] },
        "code": { "enum": [
          "malformed_input", "repository_mismatch", "repository_invalid", "repository_ref_invalid",
          "repository_format_unsupported", "repository_lock_invalid", "worktree_path_invalid",
          "base_ref_moved", "branch_exists", "worktree_mismatched", "worktree_materialization_failed",
          "worktree_unlock_failed", "worktree_removal_failed", "git_timeout", "internal_error",
          "worktree_verification_failed", "worktree_metadata_invalid", "worktree_marker_conflict",
          "worktree_removal_unverified", "worktree_lock_invalid", "task_mismatch", "commit_path_invalid",
          "commit_message_invalid", "index_not_clean", "unfinished_operation", "diff_unavailable", "diff_mismatch",
          "filter_check_failed", "commit_filter_unsupported",
          "staging_failed", "index_mismatch", "index_unavailable", "empty_commit", "commit_paths_mismatch",
          "commit_failed", "ref_moved", "ref_update_failed", "ref_update_uncertain",
          "commit_message_parse_failed", "index_invalid", "commit_verification_failed",
          "effect_request_mismatch", "fetch_remote_mismatch", "fetch_ref_mismatch", "fetch_configuration_invalid",
          "fetch_failed", "fetch_result_invalid"
        ] },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "required": ["category", "code", "message", "retryable"],
      "oneOf": [
        { "properties": { "category": { "const": "validation" }, "code": { "enum": ["malformed_input", "repository_mismatch", "repository_invalid", "repository_ref_invalid", "repository_format_unsupported", "repository_lock_invalid", "worktree_path_invalid", "task_mismatch", "commit_path_invalid", "commit_message_invalid", "effect_request_mismatch", "fetch_remote_mismatch", "fetch_ref_mismatch", "fetch_configuration_invalid"] }, "retryable": { "const": false } } },
        { "properties": { "category": { "const": "conflict" }, "code": { "enum": ["base_ref_moved", "branch_exists", "worktree_mismatched", "worktree_materialization_failed", "worktree_unlock_failed", "worktree_removal_failed", "index_not_clean", "unfinished_operation", "diff_unavailable", "diff_mismatch", "filter_check_failed", "commit_filter_unsupported", "staging_failed", "index_mismatch", "index_unavailable", "empty_commit", "commit_paths_mismatch", "commit_failed", "ref_moved", "ref_update_failed"] }, "retryable": { "const": false } } },
        { "properties": { "category": { "const": "transient" }, "code": { "enum": ["git_timeout", "ref_update_uncertain", "fetch_failed"] }, "retryable": { "const": true } } },
        { "properties": { "category": { "const": "internal" }, "code": { "enum": ["internal_error", "worktree_verification_failed", "worktree_metadata_invalid", "worktree_marker_conflict", "worktree_removal_unverified", "worktree_lock_invalid", "commit_message_parse_failed", "index_invalid", "commit_verification_failed", "fetch_result_invalid"] }, "retryable": { "const": false } } }
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "operation": { "enum": ["materialize", "observe", "remove", "commit", "fetch", "unknown"] },
        "outcome": { "const": "failed" },
        "error": { "$ref": "#/$defs/error" }
      },
      "required": ["schema_version", "operation", "outcome", "error"],
      "allOf": [
        { "if": { "properties": { "operation": { "const": "materialize" } }, "required": ["operation"] }, "then": { "properties": { "error": { "properties": { "code": { "enum": ["malformed_input", "repository_mismatch", "repository_invalid", "repository_ref_invalid", "repository_format_unsupported", "repository_lock_invalid", "worktree_path_invalid", "base_ref_moved", "branch_exists", "worktree_mismatched", "worktree_materialization_failed", "git_timeout", "internal_error", "worktree_verification_failed", "worktree_metadata_invalid", "worktree_marker_conflict"] } } } } } },
        { "if": { "properties": { "operation": { "const": "observe" } }, "required": ["operation"] }, "then": { "properties": { "error": { "properties": { "code": { "enum": ["malformed_input", "repository_mismatch", "repository_invalid", "repository_ref_invalid", "repository_format_unsupported", "worktree_path_invalid", "git_timeout", "internal_error"] } } } } } },
        { "if": { "properties": { "operation": { "const": "remove" } }, "required": ["operation"] }, "then": { "properties": { "error": { "properties": { "code": { "enum": ["malformed_input", "repository_mismatch", "repository_invalid", "repository_ref_invalid", "repository_format_unsupported", "repository_lock_invalid", "worktree_path_invalid", "worktree_unlock_failed", "worktree_removal_failed", "git_timeout", "internal_error", "worktree_metadata_invalid", "worktree_removal_unverified", "worktree_lock_invalid"] } } } } } },
        { "if": { "properties": { "operation": { "const": "commit" } }, "required": ["operation"] }, "then": { "properties": { "error": { "properties": { "code": { "enum": ["malformed_input", "repository_mismatch", "repository_invalid", "repository_ref_invalid", "repository_format_unsupported", "repository_lock_invalid", "worktree_path_invalid", "task_mismatch", "commit_path_invalid", "commit_message_invalid", "worktree_mismatched", "index_not_clean", "unfinished_operation", "diff_unavailable", "diff_mismatch", "filter_check_failed", "commit_filter_unsupported", "staging_failed", "index_mismatch", "index_unavailable", "empty_commit", "commit_paths_mismatch", "commit_failed", "ref_moved", "ref_update_failed", "git_timeout", "ref_update_uncertain", "internal_error", "commit_message_parse_failed", "index_invalid", "commit_verification_failed"] } } } } } },
        { "if": { "properties": { "operation": { "const": "fetch" } }, "required": ["operation"] }, "then": { "properties": { "error": { "properties": { "code": { "enum": ["malformed_input", "repository_mismatch", "repository_invalid", "repository_ref_invalid", "repository_format_unsupported", "repository_lock_invalid", "effect_request_mismatch", "fetch_remote_mismatch", "fetch_ref_mismatch", "fetch_configuration_invalid", "fetch_failed", "fetch_result_invalid", "git_timeout", "internal_error"] } } } } } },
        { "if": { "properties": { "operation": { "const": "unknown" } }, "required": ["operation"] }, "then": { "properties": { "error": { "properties": { "code": { "const": "malformed_input" } } } } } }
      ],
      "additionalProperties": false
    }
  }
}
