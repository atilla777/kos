{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/project/v1/common.json",
  "$defs": {
    "schema_version": { "const": "1" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "semantic_version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "project_path": { "type": "string", "pattern": "^\\.kos/(?:[^/]+/)*[^/]+$" },
    "markdown_path": { "allOf": [{ "$ref": "#/$defs/project_path" }, { "pattern": "\\.md$" }] },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifact_requirement": {
      "oneOf": [
        { "$ref": "#/$defs/document_requirement" },
        { "$ref": "#/$defs/candidate_requirement" },
        { "$ref": "#/$defs/test_requirement" },
        { "$ref": "#/$defs/review_requirement" },
        { "$ref": "#/$defs/publication_requirement" }
      ]
    },
    "requirement_base": {
      "type": "object",
      "properties": {
        "type": { "enum": ["document", "candidate", "test", "review", "publication"] },
        "cardinality": { "enum": ["one", "many"] },
        "subject": { "enum": ["task", "candidate"] },
        "allowed_states": {
          "type": "array",
          "items": { "enum": ["produced", "passed", "failed", "approved", "changes_requested", "published"] },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["type", "cardinality", "subject", "allowed_states"],
      "additionalProperties": false
    },
    "document_requirement": {
      "allOf": [
        { "$ref": "#/$defs/requirement_base" },
        { "properties": { "type": { "const": "document" }, "subject": { "const": "task" }, "allowed_states": { "items": { "const": "produced" } } } }
      ]
    },
    "candidate_requirement": {
      "allOf": [
        { "$ref": "#/$defs/requirement_base" },
        { "properties": { "type": { "const": "candidate" }, "subject": { "const": "task" }, "allowed_states": { "items": { "const": "produced" } } } }
      ]
    },
    "test_requirement": {
      "allOf": [
        { "$ref": "#/$defs/requirement_base" },
        { "properties": { "type": { "const": "test" }, "subject": { "const": "candidate" }, "allowed_states": { "items": { "enum": ["passed", "failed"] } } } }
      ]
    },
    "review_requirement": {
      "allOf": [
        { "$ref": "#/$defs/requirement_base" },
        { "properties": { "type": { "const": "review" }, "subject": { "const": "candidate" }, "allowed_states": { "items": { "enum": ["approved", "changes_requested"] } } } }
      ]
    },
    "publication_requirement": {
      "allOf": [
        { "$ref": "#/$defs/requirement_base" },
        { "properties": { "type": { "const": "publication" }, "subject": { "const": "candidate" }, "allowed_states": { "items": { "const": "published" } } } }
      ]
    }
  }
}
