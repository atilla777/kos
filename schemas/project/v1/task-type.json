{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/project/v1/task-type.json",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/schema_version" },
    "id": { "$ref": "common.json#/$defs/identifier" },
    "workflow": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.json#/$defs/identifier" },
        "version": { "$ref": "common.json#/$defs/semantic_version" },
        "path": { "$ref": "common.json#/$defs/project_path" }
      },
      "required": ["id", "version", "path"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "id", "workflow"],
  "additionalProperties": false
}
