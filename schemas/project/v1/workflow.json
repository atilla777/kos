{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kos.local/schemas/project/v1/workflow.json",
  "$defs": {
    "status": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.json#/$defs/identifier" },
        "execution_mode": { "enum": ["main_session", "subagent"] },
        "instruction": { "$ref": "common.json#/$defs/markdown_path", "x-media-type": "text/markdown; charset=utf-8", "x-min-utf8-bytes": 1, "x-max-utf8-bytes": 131072 },
        "materials": { "type": "array", "items": { "$ref": "#/$defs/material" }, "x-unique-by": "path" },
        "allowed_capabilities": { "type": "array", "items": { "$ref": "common.json#/$defs/identifier" }, "uniqueItems": true },
        "worktree": { "enum": ["required", "none"] },
        "repository_changes": { "enum": ["allowed", "forbidden"] },
        "required_artifacts": { "type": "array", "items": { "$ref": "common.json#/$defs/artifact_requirement" } }
      },
      "required": ["id", "execution_mode", "instruction", "materials", "allowed_capabilities", "worktree", "repository_changes", "required_artifacts"],
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "path": { "$ref": "common.json#/$defs/project_path" },
        "media_type": { "enum": ["text/markdown; charset=utf-8", "application/yaml; charset=utf-8"] }
      },
      "required": ["path", "media_type"],
      "x-min-utf8-bytes": 1,
      "x-max-utf8-bytes": 1048576,
      "additionalProperties": false
    },
    "always_condition": {
      "type": "object", "properties": { "type": { "const": "always" } }, "required": ["type"], "additionalProperties": false
    },
    "artifact_present_condition": {
      "type": "object",
      "properties": { "type": { "const": "artifact-present" }, "artifact_type": { "enum": ["document", "candidate", "test", "review", "publication"] } },
      "required": ["type", "artifact_type"], "additionalProperties": false
    },
    "artifact_state_condition": {
      "type": "object",
      "properties": {
        "type": { "const": "artifact-state" },
        "artifact_type": { "enum": ["document", "candidate", "test", "review", "publication"] },
        "state": { "enum": ["produced", "passed", "failed", "approved", "changes_requested", "published"] }
      },
      "required": ["type", "artifact_type", "state"], "additionalProperties": false
    },
    "decision_condition": {
      "type": "object",
      "properties": {
        "type": { "const": "decision" },
        "decision": { "$ref": "common.json#/$defs/identifier" },
        "value": { "$ref": "common.json#/$defs/identifier" }
      },
      "required": ["type", "decision", "value"], "additionalProperties": false
    },
    "not_applicable_condition": {
      "type": "object",
      "properties": { "type": { "const": "not-applicable" }, "artifact_type": { "enum": ["document", "candidate", "test", "review", "publication"] } },
      "required": ["type", "artifact_type"], "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/always_condition" },
        { "$ref": "#/$defs/artifact_present_condition" },
        { "$ref": "#/$defs/artifact_state_condition" },
        { "$ref": "#/$defs/decision_condition" },
        { "$ref": "#/$defs/not_applicable_condition" }
      ]
    },
    "transition": {
      "type": "object",
      "properties": {
        "from": { "$ref": "common.json#/$defs/identifier" },
        "to": { "$ref": "common.json#/$defs/identifier" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "minItems": 1, "uniqueItems": true }
      },
      "required": ["from", "to", "conditions"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/schema_version" },
    "id": { "$ref": "common.json#/$defs/identifier" },
    "version": { "$ref": "common.json#/$defs/semantic_version" },
    "initial_status": { "$ref": "common.json#/$defs/identifier" },
    "terminal_status": { "$ref": "common.json#/$defs/identifier" },
    "statuses": { "type": "array", "items": { "$ref": "#/$defs/status" }, "minItems": 1 },
    "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" }, "minItems": 1 }
  },
  "required": ["schema_version", "id", "version", "initial_status", "terminal_status", "statuses", "transitions"],
  "x-max-total-member-content-bytes": 4194304,
  "additionalProperties": false
}
