#!/usr/bin/env ruby

require "fileutils"
require "json"
require "net/http"
require "open3"
require "socket"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)

class Acceptance
  def initialize(directory)
    @directory = directory
    @database = File.join(directory, "kos.sqlite3")
    @backup = File.join(directory, "kos-backup.sqlite3")
    @restored = File.join(directory, "kos-restored.sqlite3")
    @gem_home = File.join(directory, "gems")
    @gem_file = File.join(directory, "kos-cli.gem")
    @server_log = File.join(directory, "server.log")
    @port = available_port
    @url = "http://127.0.0.1:#{@port}"
  end

  def run
    build_and_install_cli
    prepare_database
    ssh_repository, https_repository, outside_repository = prepare_repositories
    start_server

    verify_main_cycle(ssh_repository, https_repository, outside_repository)
    create_online_backup
  ensure
    stop_server
    verify_restore if File.exist?(@backup)
  end

  private

  def build_and_install_cli
    run!("gem", "build", "kos-cli.gemspec", "--output", @gem_file, chdir: File.join(ROOT, "cli"))
    run!("gem", "install", "--install-dir", @gem_home, "--no-document", @gem_file)
    raise "Installed kos executable is missing" unless File.executable?(kos_executable)
  end

  def prepare_database
    run!("bin/rails", "db:prepare", env: server_environment)
  end

  def prepare_repositories
    ssh_repository = create_repository("ssh-clone", "git@github.com:acceptance/kos-example.git")
    https_repository = create_repository("https-clone", "https://github.com/acceptance/kos-example.git")
    outside_repository = File.join(@directory, "outside-repository")
    FileUtils.mkdir(outside_repository)
    [ ssh_repository, https_repository, outside_repository ]
  end

  def create_repository(name, remote)
    path = File.join(@directory, name)
    run!("git", "init", "--quiet", path)
    run!("git", "-C", path, "remote", "add", "origin", remote)
    path
  end

  def start_server
    log = File.open(@server_log, "w")
    @server_pid = Process.spawn(
      server_environment,
      "bin/rails", "server", "--environment", "test", "--binding", "127.0.0.1",
      chdir: ROOT,
      out: log,
      err: [ :child, :out ]
    )
    log.close
    wait_for_server
  end

  def wait_for_server
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 15
    loop do
      begin
        http = Net::HTTP.new("127.0.0.1", @port, nil)
        http.open_timeout = 1
        http.read_timeout = 1
        return if http.get("/up").is_a?(Net::HTTPSuccess)
      rescue Errno::ECONNREFUSED, Net::OpenTimeout, Net::ReadTimeout
        # The process can be alive before Rails is ready to serve requests.
      ensure
        raise "KOS server failed to start" unless process_running?(@server_pid)
        raise "Timed out waiting for KOS server" if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
      end

      sleep 0.1
    end
  end

  def verify_main_cycle(ssh_repository, https_repository, outside_repository)
    git_state = repository_state(ssh_repository)
    definition = {
      name: "Acceptance workflow",
      steps: [
        { name: "Report", instructions: "Write a test report.", executor: "subagent",
          model_tier: "standard", inputs: [], outputs: [ "test_report" ] },
        { name: "Finish", instructions: "Review the report.", executor: "main",
          inputs: [ { source: "task", key: "test_report" } ], outputs: [] }
      ]
    }
    workflow = kos("workflow", "create", "--file", "-", chdir: ssh_repository,
      stdin_data: JSON.generate(definition))
    workflow_id = workflow.dig("data", "workflow", "id") or raise "Workflow creation returned no ID"
    created = kos(
      "task", "create",
      "--workflow-id", workflow_id.to_s,
      "--kind", "feature",
      "--title", "Acceptance task",
      "--description", "Verify the installed CLI against the local server.",
      chdir: ssh_repository
    )
    task_id = created.dig("data", "task", "id") or raise "Task creation returned no ID"

    listed = kos("task", "list", chdir: https_repository)
    assert(listed.dig("data", "tasks").any? { |task| task["id"] == task_id }, "Equivalent remotes resolved differently")
    assert(repository_state(ssh_repository) == git_state, "A normal KOS command changed Git state")

    missing_project = kos_result("task", "list", chdir: outside_repository)
    assert(missing_project.fetch(:status).exitstatus == 2, "Missing Git context did not return a usage error")
    assert(JSON.parse(missing_project.fetch(:stdout)).dig("error", "code") == "invalid_usage", "Missing Git error was not JSON")
    kos("--project", "github.com/acceptance/kos-example", "task", "list", chdir: outside_repository)

    claimed = kos("--session", "acceptance-agent", "task", "claim-next", "--route", chdir: https_repository)
    task = claimed.dig("data", "task") or raise "claim-next returned no task"
    assert(task.fetch("id") == task_id, "claim-next selected an unexpected task")
    assert(task.dig("step", "model_tier") == "standard", "Wrong model tier in route")
    assert(!task.key?("artifacts"), "Compact route exposed artifacts")
    claim_id = task.fetch("claim_id")

    packet = kos("task", "step", "show", task_id.to_s, chdir: https_repository)
    assert(packet.dig("data", "step", "instructions") == "Write a test report.", "Step instruction missing")

    artifact = kos(
      "--claim", claim_id,
      "task", "artifact", "put", task_id.to_s, "test_report", "--file", "-",
      chdir: https_repository,
      stdin_data: "# Test report\n\nAcceptance passed.\n"
    )
    assert(artifact.dig("data", "artifact", "content").include?("Acceptance passed"), "Artifact was not saved")

    advanced = kos("--claim", claim_id, "task", "advance", task_id.to_s,
      "--expected-step", "0", chdir: https_repository)
    assert(advanced.dig("data", "task", "current_step") == 1, "Task did not advance")
    packet = kos("task", "step", "show", task_id.to_s, chdir: https_repository)
    assert(packet.dig("data", "step", "inputs", 0, "artifacts", 0, "content").include?("Acceptance passed"),
      "Next step could not read the previous result")

    completed = kos(
      "--claim", claim_id,
      "task", "complete", task_id.to_s, "--work-summary", "Acceptance passed.",
      chdir: https_repository
    )
    assert(completed.dig("data", "task", "status") == "done", "Task was not completed")

    ready = kos("task", "ready", chdir: ssh_repository)
    assert(ready.dig("data", "tasks").none? { |item| item["id"] == task_id }, "Completed task remained ready")

    verify_fingerprint_cycle(ssh_repository, workflow_id)
  end

  def verify_fingerprint_cycle(repository, workflow_id)
    created = kos("task", "create", "--workflow-id", workflow_id.to_s, "--kind", "acceptance",
      "--title", "Fingerprint task", "--description", "Write without exposing a claim.", chdir: repository)
    task_id = created.dig("data", "task", "id")
    first_session = kos("session", "new", chdir: @directory).dig("data", "session_id")
    second_session = kos("session", "new", chdir: @directory).dig("data", "session_id")
    assert(first_session != second_session, "Independent conversations shared a session ID")
    claimed = kos("--session", first_session, "task", "claim", task_id.to_s, "--fingerprint", chdir: repository)
    route = claimed.dig("data", "task")
    fingerprint = route.fetch("claim_fingerprint")
    assert(fingerprint.match?(/\A[0-9a-f]{64}\z/), "Invalid claim fingerprint")
    assert(!route.key?("claim_id"), "Fingerprint route exposed claim")

    resumed = kos("--session", first_session, "task", "current", "--fingerprint", chdir: repository)
    assert(resumed.dig("data", "task", "claim_fingerprint") == fingerprint, "Same conversation did not recover its claim")
    assert(resumed.dig("data", "task", "current_step") == 0, "Same conversation lost its step")
    assert(kos("--session", second_session, "task", "current", "--fingerprint", chdir: repository).dig("data", "task").nil?,
      "Another conversation recovered a claim under the wrong ID")
    other_claim = kos_result("--session", second_session, "task", "claim", task_id.to_s, "--fingerprint", chdir: repository)
    assert(other_claim.fetch(:status).exitstatus == 4, "Another conversation claimed a live task")
    assert(JSON.parse(other_claim.fetch(:stdout)).dig("error", "code") == "task_already_claimed", "Wrong live-claim error")
    shown = kos("task", "show", task_id.to_s, chdir: repository).dig("data", "task")
    assert(shown.fetch("session_id") == first_session, "Task view did not identify the previous session")
    assert(shown.key?("lease_expires_at") && !shown.key?("claim_id"), "Task view exposed the claim or omitted the lease")

    # The human confirmation belongs to the OpenCode procedure. This checks that
    # the ID exposed by task show can recover the unchanged active claim.
    assert(kos("--session", shown.fetch("session_id"), "task", "current", "--fingerprint",
      chdir: repository).dig("data", "task", "claim_fingerprint") == fingerprint, "Confirmed takeover changed the claim")
    args = [ "--session", first_session, "--claim-fingerprint", fingerprint ]
    kos(*args, "task", "artifact", "put", task_id.to_s, "test_report", "--file", "-",
      "--expected-step", "0", chdir: repository, stdin_data: "# Fingerprint report\n")
    advanced = kos(*args, "task", "advance", task_id.to_s, "--expected-step", "0", chdir: repository)
    assert(!advanced.dig("data", "task").key?("claim_id"), "Fingerprint advance exposed claim")
    assert(kos("--session", first_session, "task", "current", "--fingerprint",
      chdir: repository).dig("data", "task", "current_step") == 1, "Resumed conversation lost the advanced step")

    run!("sqlite3", @database, "UPDATE tasks SET claimed_at = '1999-01-01 00:00:00', lease_expires_at = '2000-01-01 00:00:00' WHERE id = #{task_id};")
    assert(kos("--session", first_session, "task", "current", "--fingerprint", chdir: repository).dig("data", "task").nil?,
      "Expired claim still appeared current")
    reclaimed = kos("--session", second_session, "task", "claim", task_id.to_s, "--fingerprint", chdir: repository)
    new_fingerprint = reclaimed.dig("data", "task", "claim_fingerprint")
    assert(new_fingerprint != fingerprint, "Reclaim reused the old claim")
    assert(reclaimed.dig("data", "task", "current_step") == 1, "Reclaim reset the step")
    assert(kos("task", "artifact", "get", task_id.to_s, "test_report", chdir: repository)
      .dig("data", "artifact", "content") == "# Fingerprint report\n", "Reclaim lost the artifact")
    stale = kos_result(*args, "task", "complete", task_id.to_s, chdir: repository)
    assert(stale.fetch(:status).exitstatus == 4, "Old fingerprint was allowed to complete after reclaim")
    assert(JSON.parse(stale.fetch(:stdout)).dig("error", "code") == "claim_mismatch", "Old owner did not get a conflict")
    completed = kos("--session", second_session, "--claim-fingerprint", new_fingerprint,
      "task", "complete", task_id.to_s, chdir: repository)
    assert(completed.dig("data", "task", "status") == "done", "Fingerprint task did not complete")
    assert(!completed.dig("data", "task").key?("claim_id"), "Fingerprint completion exposed claim")
  end

  def create_online_backup
    run!("sqlite3", @database, ".backup '#{@backup}'")
  end

  def verify_restore
    FileUtils.rm_f(@restored)
    run!("sqlite3", @restored, ".restore '#{@backup}'")
    output, = run!("sqlite3", @restored, "SELECT status FROM tasks WHERE title = 'Acceptance task';")
    assert(output.strip == "done", "Restored database did not contain the completed task")
  end

  def kos(*arguments, chdir:, stdin_data: "")
    result = kos_result(*arguments, chdir: chdir, stdin_data: stdin_data)
    unless result.fetch(:status).success?
      parsed = JSON.parse(result.fetch(:stdout))
      code = parsed.is_a?(Hash) ? parsed.dig("error", "code") : "json_#{parsed.class.name.downcase}"
      raise "Installed kos command failed with exit #{result.fetch(:status).exitstatus} (#{code || "unknown"})"
    end

    JSON.parse(result.fetch(:stdout))
  rescue JSON::ParserError
    diagnostic = result.fetch(:stderr).lines.first.to_s.strip.gsub(/[0-9a-f]{32,}/, "[REDACTED]")
    raise "Installed kos command returned non-JSON stdout (#{result.fetch(:stdout).bytesize} bytes; #{diagnostic})"
  end

  def kos_result(*arguments, chdir:, stdin_data: "")
    stdout, stderr, status = Open3.capture3(
      cli_environment,
      kos_executable,
      *arguments,
      chdir: chdir,
      stdin_data: stdin_data
    )
    { stdout: stdout, stderr: stderr, status: status }
  end

  def repository_state(path)
    branch, = run!("git", "-C", path, "symbolic-ref", "--short", "HEAD")
    remote, = run!("git", "-C", path, "remote", "get-url", "origin")
    status, = run!("git", "-C", path, "status", "--porcelain=v1")
    [ branch, remote, status ]
  end

  def run!(*command, chdir: ROOT, env: {}, stdin_data: "")
    stdout, stderr, status = Open3.capture3(env, *command, chdir: chdir, stdin_data: stdin_data)
    raise "#{command.first} failed with exit #{status.exitstatus}: #{stderr}" unless status.success?

    [ stdout, stderr ]
  end

  def server_environment
    {
      "RAILS_ENV" => "test",
      "KOS_TEST_DATABASE" => @database,
      "PORT" => @port.to_s,
      "PIDFILE" => File.join(@directory, "server.pid")
    }
  end

  def cli_environment
    {
      "BUNDLE_BIN_PATH" => nil,
      "BUNDLE_GEMFILE" => nil,
      "BUNDLE_PATH" => nil,
      "GEM_HOME" => @gem_home,
      "GEM_PATH" => ([ @gem_home ] + Gem.path).uniq.join(File::PATH_SEPARATOR),
      "KOS_API_URL" => @url,
      "RUBYLIB" => nil,
      "RUBYOPT" => nil
    }
  end

  def kos_executable
    File.join(@gem_home, "bin", "kos")
  end

  def available_port
    server = TCPServer.new("127.0.0.1", 0)
    server.addr[1]
  ensure
    server&.close
  end

  def process_running?(pid)
    Process.kill(0, pid)
    true
  rescue Errno::ESRCH
    false
  end

  def stop_server
    return unless @server_pid && process_running?(@server_pid)

    Process.kill("TERM", @server_pid)
    Process.wait(@server_pid)
  end

  def assert(condition, message)
    raise message unless condition
  end
end

Dir.mktmpdir("kos-acceptance") do |directory|
  Acceptance.new(directory).run
end

puts "KOS acceptance passed: clean CLI install, end-to-end task cycle, and SQLite backup/restore."
